{
  "name": "telegram-archive-bot",
  "version": "1.0.0",
  "description": "Fully dynamic Telegram forum-topic archive bot (no hardcoded academic categories)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/local.js",
    "dev": "ts-node-dev --respawn --transpile-only src/local.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "set-webhook": "ts-node scripts/set-webhook.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mongoose": "^8.7.0",
    "telegraf": "^4.16.3",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@vercel/node": "^13.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}

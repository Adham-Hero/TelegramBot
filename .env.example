# ==== Telegram ====
# Token from @BotFather — NEVER put the real value here, only in your local .env
BOT_TOKEN=

# Numeric Telegram user ID of the bot administrator (get it from @userinfobot)
ADMIN_ID=

# Numeric ID of the forum supergroup that holds the archive (starts with -100...)
ARCHIVE_GROUP_ID=

# ==== Database ====
# MongoDB Atlas connection string — NEVER put the real value here, only in your local .env
MONGODB_URI=

# ==== Behavior ====
# Separator used inside topic names, e.g. "سنة أولى | ترم أول | Anatomy | شرح"
TOPIC_NAME_SEPARATOR=|

# Items per page in list/search pagination
PAGE_SIZE=10

# Log level: error | warn | info | debug
LOG_LEVEL=info

# "polling" for local development, "webhook" on Vercel
BOT_MODE=webhook

# ==== Webhook (Vercel) ====
# Optional. Only used by `npm run set-webhook` to know which public URL to
# register with Telegram. Not read by the deployed function itself (Vercel
# routes any request to /api/telegram to the function regardless of this
# value). Example: https://your-project.vercel.app
WEBHOOK_DOMAIN=

# Optional but recommended. A random string only you and Telegram know;
# the webhook handler rejects any POST that doesn't carry this secret in
# the X-Telegram-Bot-Api-Secret-Token header, so nobody else can send fake
# "updates" straight to your endpoint. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=
